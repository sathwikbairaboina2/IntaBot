NODE_ENV=development
PORT=4100

# Host ports are remapped away from the defaults because this machine runs
# other projects on 8000 and 9000/9001. See docker-compose.yml.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMO_ENDPOINT=http://localhost:8200
DYNAMO_TABLE_MAIN=intabot_main
DYNAMO_TABLE_CHECKPOINTS=intabot_checkpoints

REDIS_URL=redis://localhost:6479

S3_ENDPOINT=http://localhost:9200
S3_BUCKET=intabot-media
S3_ACCESS_KEY=intabot
S3_SECRET_KEY=intabot-dev-secret

# 32 raw bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

SESSION_TTL_HOURS=168

# Filled in by Phase 0 Meta app setup. Required for webhooks and live mode.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# fake (default) routes all Instagram calls to the in-memory adapter.
# live requires META_APP_SECRET and real account tokens.
INSTAGRAM_MODE=fake

# Dashboard origin (CORS) and the API the dashboard calls.
WEB_ORIGIN=http://localhost:3100
API_BASE_URL=http://localhost:4100

# Which implementation backs the copy writer, comment classifier and reply
# writer. Leave blank to keep the original rule: a key below means anthropic,
# no key means the deterministic fakes.
#   fake      - deterministic, no network, the test default
#   anthropic - claude-opus-5, needs ANTHROPIC_API_KEY
#   ollama    - a local model, needs the ollama service from docker-compose
LLM_PROVIDER=

# Optional. Without it the deterministic FakeCopyWriter is used and no
# caption generation reaches the Anthropic API.
ANTHROPIC_API_KEY=

# Local model runtime: the Ollama installed on the host, shared by every
# project on this machine. Pull the model once with:
#   ollama pull qwen3.8:27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# Job-card handoff from Studio (POST /handoff/job-card). Unset HANDOFF_KEY
# disables the endpoint (503). Studio sends the key in x-handoff-key.
HANDOFF_KEY=
# Account that handoff posts land on when the request names none. Blank means
# the only ACTIVE account.
HANDOFF_ACCOUNT_ID=

# Redis key prefix for the queues; give a second local instance its own.
QUEUE_PREFIX=intabot
# How often the publish scan looks for approved posts that are due.
PUBLISH_SCAN_INTERVAL_MS=60000
